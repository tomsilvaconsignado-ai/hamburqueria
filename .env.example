# ---------------------------------------------------------------------------
# Frontend (Vite) — copie para .env.local
# Obtenha em: Supabase > Project Settings > API
#
# Sem estas variáveis o app roda em MODO DEMONSTRAÇÃO: dados fictícios salvos
# apenas no navegador, seletor de perfis visível. Nunca publique assim.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-chave-anon-publica"

# Mapas (Mapbox): token PÚBLICO "pk." restrito às URLs do site no painel do Mapbox.
# Sem ele os mapas não aparecem e o resto do app funciona igual.
# O token do servidor (taxa por distância) fica no banco: veja o README, seção 6.
VITE_MAPBOX_TOKEN=""

# ---------------------------------------------------------------------------
# Edge Functions — NÃO vão para o frontend. Configure com:
#   supabase secrets set MP_ACCESS_TOKEN=... MP_WEBHOOK_SECRET=... SITE_URL=...
# (SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY já são injetadas pelo Supabase)
# ---------------------------------------------------------------------------
# MP_ACCESS_TOKEN="APP_USR-..."          # Mercado Pago > Credenciais de produção
# MP_WEBHOOK_SECRET="..."                # Mercado Pago > Webhooks > Assinatura secreta
# SITE_URL="https://seu-dominio.com.br"  # usado em CORS e URLs de retorno do pagamento
